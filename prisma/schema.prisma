generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  ADMIN      @map("admin")
  FARM_OWNER @map("farm_owner")
  TECHNICIAN @map("technician")
  EXPERT     @map("expert")

  @@map("account_role")
}

enum AccountStatus {
  PENDING_ACTIVATION @map("pending_activation")
  ACTIVE             @map("active")
  INACTIVE           @map("inactive")
  BLOCKED            @map("blocked")

  @@map("account_status")
}

enum VerificationPurpose {
  ACCOUNT_ACTIVATION @map("account_activation")
  PASSWORD_RESET     @map("password_reset")

  @@map("verification_purpose")
}

enum SeasonStatus {
  PLANNING  @map("planning")
  ACTIVE    @map("active")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")

  @@map("season_status")
}

enum PersonnelRole {
  TECHNICIAN @map("technician")
  EXPERT     @map("expert")

  @@map("personnel_role")
}

enum PondStatus {
  AVAILABLE   @map("available")
  MAINTENANCE @map("maintenance")
  INACTIVE    @map("inactive")

  @@map("pond_status")
}

enum PondType {
  AQUACULTURE     @map("aquaculture")
  WATER_TREATMENT @map("water_treatment")

  @@map("pond_type")
}

enum ShrimpType {
  WHITELEG    @map("whiteleg")
  BLACK_TIGER @map("black_tiger")

  @@map("shrimp_type")
}

enum HealthStatus {
  EXCELLENT @map("excellent")
  GOOD      @map("good")
  WARNING   @map("warning")
  CRITICAL  @map("critical")

  @@map("health_status")
}

enum CaseSeverity {
  LOW      @map("low")
  MEDIUM   @map("medium")
  HIGH     @map("high")
  CRITICAL @map("critical")

  @@map("case_severity")
}

enum DiseaseCaseStatus {
  OPEN             @map("open")
  WAITING_FOR_INFO @map("waiting_for_info")
  MONITORING       @map("monitoring")
  IN_TREATMENT     @map("in_treatment")
  RESOLVED         @map("resolved")

  @@map("disease_case_status")
}

enum ProtocolStatus {
  DRAFT            @map("draft")
  PENDING_APPROVAL @map("pending_approval")
  APPROVED         @map("approved")
  REJECTED         @map("rejected")
  SUPERSEDED       @map("superseded")
  CANCELLED        @map("cancelled")
  ABORTED          @map("aborted")

  @@map("protocol_status")
}

enum ProtocolType {
  PRODUCTION @map("production")
  TREATMENT  @map("treatment")

  @@map("protocol_type")
}

enum ProductCategory {
  FEED     @map("feed")
  MEDICINE @map("medicine")
  MINERAL  @map("mineral")
  CHEMICAL @map("chemical")
  OTHER    @map("other")

  @@map("product_category")
}

enum ProductUnit {
  KG     @map("kg")
  G      @map("g")
  L      @map("l")
  ML     @map("ml")
  PACK   @map("pack")
  BOTTLE @map("bottle")
  PCS    @map("pcs")

  @@map("product_unit")
}

enum ConversionUnit {
  MG @map("mg")
  G  @map("g")
  KG @map("kg")
  ML @map("ml")
  L  @map("l")

  @@map("conversion_unit")
}


enum OperationType {
  FEEDING  @map("feeding")
  MINERAL  @map("mineral")
  CHEMICAL @map("chemical")
  MEDICINE @map("medicine")
  OTHER    @map("other")

  @@map("operation_type")
}

enum OperationStatus {
  PLANNED   @map("planned")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")

  @@map("operation_status")
}

enum DoseBasis {
  FIXED_QUANTITY  @map("fixed_quantity")
  PER_KG_BIOMASS  @map("per_kg_biomass")
  PERCENT_BIOMASS @map("percent_biomass")
  PER_M3_WATER    @map("per_m3_water")

  @@map("dose_basis")
}

enum ScheduleCancellationType {
  PROTOCOL_SUPERSEDED @map("protocol_superseded")
  TREATMENT_ABORTED   @map("treatment_aborted")
  SEASON_CANCELLED    @map("season_cancelled")
  MANUAL_CORRECTION   @map("manual_correction")

  @@map("schedule_cancellation_type")
}

enum InventoryTransactionType {
  STOCK_IN  @map("stock_in")
  STOCK_OUT @map("stock_out")

  @@map("inventory_transaction_type")
}

enum TaskPriority {
  LOW    @map("low")
  NORMAL @map("normal")
  HIGH   @map("high")
  URGENT @map("urgent")

  @@map("task_priority")
}

enum TaskStatus {
  PENDING     @map("pending")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  CANCELLED   @map("cancelled")

  @@map("task_status")
}

enum NotificationType {
  SYSTEM                       @map("system")
  MANAGED_ACCOUNT_ACTIVATED    @map("managed_account_activated")
  ACCOUNT_STATUS_CHANGED       @map("account_status_changed")
  SEASON_ASSIGNMENT_CREATED    @map("season_assignment_created")
  SEASON_ASSIGNMENT_REPLACED   @map("season_assignment_replaced")
  SEASON_STATUS_CHANGED        @map("season_status_changed")
  OPERATION_DUE                @map("operation_due")
  OPERATION_OVERDUE            @map("operation_overdue")
  OPERATION_CANCELLED          @map("operation_cancelled")
  SCHEDULE_GENERATION_FAILED   @map("schedule_generation_failed")
  WATER_THRESHOLD_EXCEEDED     @map("water_threshold_exceeded")
  TASK_ASSIGNED                @map("task_assigned")
  TASK_UPDATED                 @map("task_updated")
  TASK_DUE_SOON                @map("task_due_soon")
  TASK_OVERDUE                 @map("task_overdue")
  TASK_COMPLETED               @map("task_completed")
  DISEASE_CASE_CREATED         @map("disease_case_created")
  DISEASE_CASE_RESPONSE        @map("disease_case_response")
  DISEASE_CASE_WAITING_INFO    @map("disease_case_waiting_info")
  DISEASE_CASE_MONITORING      @map("disease_case_monitoring")
  DISEASE_CASE_RESOLVED        @map("disease_case_resolved")
  PRODUCTION_PROTOCOL_PENDING  @map("production_protocol_pending")
  PRODUCTION_PROTOCOL_REVIEWED @map("production_protocol_reviewed")
  TREATMENT_PROTOCOL_PENDING   @map("treatment_protocol_pending")
  TREATMENT_PROTOCOL_REVIEWED  @map("treatment_protocol_reviewed")
  TREATMENT_PROTOCOL_ABORTED   @map("treatment_protocol_aborted")
  EMERGENCY_CASE_UPDATE        @map("emergency_case_update")
  TREATMENT_SCHEDULE_READY     @map("treatment_schedule_ready")
  TREATMENT_SCHEDULE_COMPLETED @map("treatment_schedule_completed")
  INVENTORY_LOW                @map("inventory_low")
  INVENTORY_INSUFFICIENT       @map("inventory_insufficient")
  HARVEST_DUE                  @map("harvest_due")
  SEASON_COMPLETED             @map("season_completed")

  @@map("notification_type")
}

model Account {
  id                     String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String                       @unique @db.VarChar(320)
  phone                  String?                      @db.VarChar(20)
  passwordHash           String?                      @map("password_hash") @db.VarChar(255)
  fullName               String?                      @map("full_name") @db.VarChar(50)
  avatarUrl              String?                      @map("avatar_url")
  role                   AccountRole
  status                 AccountStatus                @default(PENDING_ACTIVATION)
  managedByOwnerId       String?                      @map("managed_by_owner_id") @db.Uuid
  activatedAt            DateTime?                    @map("activated_at") @db.Timestamptz(6)
  statusChangedBy        String?                      @map("status_changed_by") @db.Uuid
  statusChangedAt        DateTime?                    @map("status_changed_at") @db.Timestamptz(6)
  statusReason           String?                      @map("status_reason")
  lastLoginAt            DateTime?                    @map("last_login_at") @db.Timestamptz(6)
  createdBy              String?                      @map("created_by") @db.Uuid
  createdAt              DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                     @default(now()) @map("updated_at") @db.Timestamptz(6)
  refreshTokens          RefreshToken[]
  verificationChallenges EmailVerificationChallenge[]
  notifications          Notification[]
  managedByOwner         Account?                     @relation("OwnerManagedAccounts", fields: [managedByOwnerId], references: [id], onDelete: Restrict)
  managedAccounts        Account[]                    @relation("OwnerManagedAccounts")
  seasonAssignments      SeasonPersonnelAssignment[]  @relation("SeasonAssignedAccount")
  ownedFarms             Farm[]
  reportedDiseaseCases   DiseaseCase[]                @relation("DiseaseCaseReporter")
  ragConversations       RagConversation[]
  ragQueries             RagQuery[]
  ragFeedback            RagFeedback[]
  cancelledSchedules     OperationSchedule[]          @relation("ScheduleCancelledBy")
  executedOperations     OperationExecution[]         @relation("ExecutionExecutedBy")
  inventoryTransactions  InventoryTransaction[]       @relation("InventoryTransactionPerformedBy")

  @@map("accounts")
}

model Notification {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId     String           @map("account_id") @db.Uuid
  title         String           @db.VarChar(500)
  content       String?
  type          NotificationType
  referenceType String?          @map("reference_type") @db.VarChar(50)
  referenceId   String?          @map("reference_id") @db.Uuid
  readAt        DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  account       Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model EmailVerificationChallenge {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId            String              @map("account_id") @db.Uuid
  purpose              VerificationPurpose
  codeHash             String              @map("code_hash") @db.Char(64)
  expiresAt            DateTime            @default(dbgenerated("NOW() + INTERVAL '10 minutes'")) @map("expires_at") @db.Timestamptz(6)
  resendAvailableAt    DateTime            @default(dbgenerated("NOW() + INTERVAL '60 seconds'")) @map("resend_available_at") @db.Timestamptz(6)
  failedAttempts       Int                 @default(0) @map("failed_attempts") @db.SmallInt
  verifiedAt           DateTime?           @map("verified_at") @db.Timestamptz(6)
  actionTokenHash      String?             @unique @map("action_token_hash") @db.Char(64)
  actionTokenExpiresAt DateTime?           @map("action_token_expires_at") @db.Timestamptz(6)
  consumedAt           DateTime?           @map("consumed_at") @db.Timestamptz(6)
  supersededAt         DateTime?           @map("superseded_at") @db.Timestamptz(6)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  account              Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, createdAt(sort: Desc)], map: "idx_email_verification_lookup")
  @@map("email_verification_challenges")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(500)
  deviceId  String    @map("device_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Farm {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId           String    @map("owner_id") @db.Uuid
  name              String    @db.VarChar(255)
  address           String?
  latitude          Decimal?  @db.Decimal(10, 8)
  longitude         Decimal?  @db.Decimal(11, 8)
  totalAreaHectares Decimal?  @map("total_area_hectares") @db.Decimal(10, 2)
  isDeleted         Boolean   @default(false) @map("is_deleted")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner             Account   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  ponds             Pond[]

  @@map("farms")
}

model Pond {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmId    String              @map("farm_id") @db.Uuid
  name      String              @db.VarChar(255)
  areaM2    Decimal?            @map("area_m2") @db.Decimal(12, 2)
  depthM    Decimal?            @map("depth_m") @db.Decimal(6, 2)
  volumeM3  Decimal?            @map("volume_m3") @db.Decimal(14, 2)
  type      PondType            @default(AQUACULTURE)
  status    PondStatus          @default(AVAILABLE)
  isDeleted Boolean             @default(false) @map("is_deleted")
  deletedAt DateTime?           @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  farm      Farm                @relation(fields: [farmId], references: [id], onDelete: Restrict)
  seasons   AquacultureSeason[]

  @@map("ponds")
}

model AquacultureSeason {
  id                   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pondId               String                      @map("pond_id") @db.Uuid
  name                 String                      @db.VarChar(255)
  shrimpType           ShrimpType                  @map("shrimp_type")
  stockingDate         DateTime?                   @map("stocking_date") @db.Date
  expectedEndDate      DateTime?                   @map("expected_end_date") @db.Date
  actualEndDate        DateTime?                   @map("actual_end_date") @db.Date
  initialQuantity      BigInt?                     @map("initial_quantity") @db.BigInt
  initialDensityPerM2  Decimal?                    @map("initial_density_per_m2") @db.Decimal(12, 2)
  status               SeasonStatus                @default(PLANNING)
  cancellationReason   String?                     @map("cancellation_reason")
  createdBy            String                      @map("created_by") @db.Uuid
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  pond                 Pond                        @relation(fields: [pondId], references: [id], onDelete: Restrict)
  personnelAssignments SeasonPersonnelAssignment[]
  healthLogs           ShrimpHealthLog[]
  waterQualityLogs     WaterQualityLog[]
  diseaseCases          DiseaseCase[]
  ragConversations      RagConversation[]
  schedules             OperationSchedule[]
  inventoryTransactions InventoryTransaction[]
  protocols             Protocol[]

  @@index([pondId, status], map: "idx_seasons_pond_status")
  @@map("aquaculture_seasons")
}

model ShrimpHealthLog {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId            String              @map("season_id") @db.Uuid
  recordedAt          DateTime            @map("recorded_at") @db.Timestamptz(6)
  estimatedBiomassKg  Decimal?            @map("estimated_biomass_kg") @db.Decimal(14, 3)
  estimatedPopulation BigInt?             @map("estimated_population") @db.BigInt
  avgWeightG          Decimal?            @map("avg_weight_g") @db.Decimal(10, 3)
  healthStatus        HealthStatus        @default(GOOD) @map("health_status")
  isVoided            Boolean             @default(false) @map("is_voided")
  season              AquacultureSeason   @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  schedules           OperationSchedule[]

  @@index([seasonId, recordedAt(sort: Desc)], map: "idx_shrimp_health_season_date")
  @@map("shrimp_health_logs")
}

model WaterQualityLog {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId             String            @map("season_id") @db.Uuid
  recordedBy           String            @map("recorded_by") @db.Uuid
  recordedAt           DateTime          @map("recorded_at") @db.Timestamptz(6)
  temperatureC         Decimal?          @map("temperature_c") @db.Decimal(5, 2)
  ph                   Decimal?          @map("ph") @db.Decimal(4, 2)
  dissolvedOxygenMgL   Decimal?          @map("dissolved_oxygen_mg_l") @db.Decimal(6, 3)
  salinityPpt          Decimal?          @map("salinity_ppt") @db.Decimal(6, 3)
  nh3MgL               Decimal?          @map("nh3_mg_l") @db.Decimal(9, 5)
  no2MgL               Decimal?          @map("no2_mg_l") @db.Decimal(9, 5)
  alkalinityMgLCaCO3   Decimal?          @map("alkalinity_mg_l_caco3") @db.Decimal(9, 2)
  h2sMgL               Decimal?          @map("h2s_mg_l") @db.Decimal(9, 5)
  note                 String?
  isVoided             Boolean           @default(false) @map("is_voided")
  voidedBy             String?           @map("voided_by") @db.Uuid
  voidedAt             DateTime?         @map("voided_at") @db.Timestamptz(6)
  voidReason           String?           @map("void_reason")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  season               AquacultureSeason @relation(fields: [seasonId], references: [id], onDelete: Restrict)

  @@index([seasonId, recordedAt(sort: Desc)], map: "idx_water_quality_season_date")
  @@unique([seasonId, recordedAt, recordedBy], map: "uq_water_quality_log_no_duplicate")
  @@map("water_quality_logs")
}

model DiseaseCase {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId   String            @map("season_id") @db.Uuid
  reportedBy String            @map("reported_by") @db.Uuid
  expertId   String            @map("expert_id") @db.Uuid
  title      String            @db.VarChar(500)
  severity   CaseSeverity      @default(MEDIUM)
  status     DiseaseCaseStatus @default(OPEN)
  updatedAt  DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  season     AquacultureSeason @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  reporter   Account           @relation("DiseaseCaseReporter", fields: [reportedBy], references: [id], onDelete: Restrict)

  @@map("disease_cases")
}

model Protocol {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  protocolType         ProtocolType      @map("protocol_type")
  seasonId             String            @map("season_id") @db.Uuid
  diseaseCaseId        String?           @map("disease_case_id") @db.Uuid
  sourceTemplateId     String?           @map("source_template_id") @db.Uuid
  versionNo            Int               @map("version_no")
  supersedesProtocolId String?           @map("supersedes_protocol_id") @db.Uuid
  title                String            @db.VarChar(500)
  summary              String?
  allowedVariancePct   Decimal?          @map("allowed_variance_pct") @db.Decimal(5, 2)
  rollingWindowDays    Int               @default(7) @map("rolling_window_days") @db.SmallInt
  status               ProtocolStatus    @default(DRAFT)
  createdBy            String            @map("created_by") @db.Uuid
  submittedAt          DateTime?         @map("submitted_at") @db.Timestamptz(6)
  reviewedBy           String?           @map("reviewed_by") @db.Uuid
  reviewedAt           DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason      String?           @map("rejection_reason")
  supersededAt         DateTime?         @map("superseded_at") @db.Timestamptz(6)
  abortReason          String?           @map("abort_reason")
  abortedBy            String?           @map("aborted_by") @db.Uuid
  abortedAt            DateTime?         @map("aborted_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)

  season               AquacultureSeason @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  items                ProtocolItem[]

  @@map("protocols")
}

model ProtocolItem {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  protocolId             String              @map("protocol_id") @db.Uuid
  operationType          OperationType       @map("operation_type")
  productId              String?             @map("product_id") @db.Uuid
  recommendedProductName String?             @map("recommended_product_name") @db.VarChar(255)
  recommendedCategory    ProductCategory?    @map("recommended_category")
  startDayOffset         Int                 @map("start_day_offset")
  endDayOffset           Int                 @map("end_day_offset")
  repeatIntervalDays     Int                 @default(1) @map("repeat_interval_days") @db.SmallInt
  mealNumber             Int?                @map("meal_number")
  plannedTime            DateTime?           @map("planned_time") @db.Time(6)
  doseBasis              DoseBasis           @map("dose_basis")
  doseValue              Decimal             @map("dose_value") @db.Decimal(14, 4)
  doseUnit               ProductUnit         @map("dose_unit")
  instructions           String?
  sequenceOrder          Int                 @default(1) @map("sequence_order")
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)

  protocol               Protocol            @relation(fields: [protocolId], references: [id], onDelete: Restrict)
  product                Product?            @relation(fields: [productId], references: [id], onDelete: Restrict)
  schedules              OperationSchedule[]

  @@unique([protocolId, sequenceOrder])
  @@map("protocol_items")
}

model OperationSchedule {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  protocolItemId     String                    @map("protocol_item_id") @db.Uuid
  seasonId           String                    @map("season_id") @db.Uuid
  operationType      OperationType             @map("operation_type")
  productId          String?                   @map("product_id") @db.Uuid
  scheduledAt        DateTime                  @map("scheduled_at") @db.Timestamptz(6)
  plannedQuantity    Decimal                   @map("planned_quantity") @db.Decimal(14, 3)
  unit               ProductUnit
  doseBasisSnapshot  DoseBasis                 @map("dose_basis_snapshot")
  doseValueSnapshot  Decimal                   @map("dose_value_snapshot") @db.Decimal(14, 4)
  basisQuantity      Decimal?                  @map("basis_quantity") @db.Decimal(14, 3)
  basisUnit          String?                   @map("basis_unit") @db.VarChar(30)
  sourceHealthLogId  String?                   @map("source_health_log_id") @db.Uuid
  calculationVersion String                    @map("calculation_version") @db.VarChar(50)
  calculatedAt       DateTime                  @map("calculated_at") @db.Timestamptz(6)
  status             OperationStatus           @default(PLANNED)
  cancellationType   ScheduleCancellationType? @map("cancellation_type")
  cancellationReason String?                   @map("cancellation_reason")
  cancelledBy        String?                   @map("cancelled_by") @db.Uuid
  cancelledAt        DateTime?                 @map("cancelled_at") @db.Timestamptz(6)
  generatedAt        DateTime                  @default(now()) @map("generated_at") @db.Timestamptz(6)
  updatedAt          DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)

  protocolItem       ProtocolItem              @relation(fields: [protocolItemId], references: [id], onDelete: Restrict)
  season             AquacultureSeason         @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  product            Product?                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  cancelledByAccount Account?                  @relation("ScheduleCancelledBy", fields: [cancelledBy], references: [id], onDelete: Restrict)
  sourceHealthLog    ShrimpHealthLog?          @relation(fields: [sourceHealthLogId], references: [id], onDelete: Restrict)
  execution          OperationExecution?

  @@unique([protocolItemId, scheduledAt])
  @@index([seasonId, scheduledAt, status], map: "idx_operation_schedules_season_time")
  @@index([protocolItemId, scheduledAt, status], map: "idx_operation_schedules_protocol_item_time")
  @@map("operation_schedules")
}

model OperationExecution {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId      String            @unique @map("schedule_id") @db.Uuid
  actualProductId String?           @map("actual_product_id") @db.Uuid
  actualQuantity  Decimal           @map("actual_quantity") @db.Decimal(14, 3)
  executedBy      String            @map("executed_by") @db.Uuid
  idempotencyKey  String            @unique @map("idempotency_key") @db.Uuid
  executedAt      DateTime          @map("executed_at") @db.Timestamptz(6)
  note            String?
  varianceReason  String?           @map("variance_reason")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  schedule        OperationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  actualProduct   Product?          @relation("ExecutionActualProduct", fields: [actualProductId], references: [id], onDelete: Restrict)
  executor        Account           @relation("ExecutionExecutedBy", fields: [executedBy], references: [id], onDelete: Restrict)

  @@map("operation_executions")
}

model InventoryBalance {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId    String                 @map("product_id") @db.Uuid
  lotNumber    String                 @map("lot_number") @db.VarChar(100)
  receivedAt   DateTime               @default(now()) @map("received_at") @db.Timestamptz(6)
  quantity     Decimal                @default(0) @db.Decimal(14, 3)
  unitPrice    Decimal                @map("unit_price") @db.Decimal(14, 2)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)

  product      Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  transactions InventoryTransaction[]

  @@unique([productId, lotNumber], map: "uq_inventory_balance_product_lot")
  @@index([productId, receivedAt, id], map: "idx_inventory_balances_fifo")
  @@index([productId], map: "idx_inventory_balances_product")
  @@map("inventory_balances")
}

model InventoryTransaction {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionGroupId String                   @map("transaction_group_id") @db.Uuid
  productId          String                   @map("product_id") @db.Uuid
  inventoryBalanceId String                   @map("inventory_balance_id") @db.Uuid
  seasonId           String?                  @map("season_id") @db.Uuid
  transactionType    InventoryTransactionType @map("transaction_type")
  quantity           Decimal                  @db.Decimal(14, 3)
  unitSnapshot       ProductUnit              @map("unit_snapshot")
  totalAmount        Decimal                  @map("total_amount") @db.Decimal(18, 2)
  referenceType      String?                  @map("reference_type") @db.VarChar(50)
  referenceId        String?                  @map("reference_id") @db.Uuid
  reason             String?
  performedBy        String                   @map("performed_by") @db.Uuid
  idempotencyKey     String                   @unique @map("idempotency_key") @db.Uuid
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  product            Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryBalance   InventoryBalance         @relation(fields: [inventoryBalanceId], references: [id], onDelete: Restrict)
  season             AquacultureSeason?       @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  performer          Account                  @relation("InventoryTransactionPerformedBy", fields: [performedBy], references: [id], onDelete: Restrict)

  @@map("inventory_transactions")
}

model Product {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmId                String                 @map("farm_id") @db.Uuid
  name                  String                 @db.VarChar(255)
  category              ProductCategory
  unit                  ProductUnit
  conversionQuantity    Decimal?               @map("conversion_quantity") @db.Decimal(14, 4)
  conversionUnit        ConversionUnit?        @map("conversion_unit")
  minAlertQuantity      Decimal                @default(0) @map("min_alert_quantity") @db.Decimal(14, 3)
  description           String?
  isDeleted             Boolean                @default(false) @map("is_deleted")
  deletedAt             DateTime?              @map("deleted_at") @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  protocolItems         ProtocolItem[]
  schedules             OperationSchedule[]
  executions            OperationExecution[]   @relation("ExecutionActualProduct")
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]

  @@map("products")
}

model ProductionProtocolTemplate {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmId             String      @map("farm_id") @db.Uuid
  title              String      @db.VarChar(500)
  description        String?
  shrimpType         ShrimpType? @map("shrimp_type")
  allowedVariancePct Decimal     @default(10) @map("allowed_variance_pct") @db.Decimal(5, 2)
  createdBy          String      @map("created_by") @db.Uuid
  archivedAt         DateTime?   @map("archived_at") @db.Timestamptz(6)
  isDeleted          Boolean     @default(false) @map("is_deleted")
  deletedAt          DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("production_protocol_templates")
}

model Task {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmId             String       @map("farm_id") @db.Uuid
  seasonId           String?      @map("season_id") @db.Uuid
  assignedBy         String       @map("assigned_by") @db.Uuid
  assignedTo         String       @map("assigned_to") @db.Uuid
  title              String       @db.VarChar(500)
  description        String?
  priority           TaskPriority @default(NORMAL)
  status             TaskStatus   @default(PENDING)
  dueAt              DateTime?    @map("due_at") @db.Timestamptz(6)
  startedAt          DateTime?    @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?    @map("completed_at") @db.Timestamptz(6)
  cancellationReason String?      @map("cancellation_reason")
  isDeleted          Boolean      @default(false) @map("is_deleted")
  deletedAt          DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("tasks")
}

model SeasonPersonnelAssignment {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId               String            @map("season_id") @db.Uuid
  role                   PersonnelRole
  accountId              String            @map("account_id") @db.Uuid
  assignedBy             String            @map("assigned_by") @db.Uuid
  assignedAt             DateTime          @default(now()) @map("assigned_at") @db.Timestamptz(6)
  unassignedAt           DateTime?         @map("unassigned_at") @db.Timestamptz(6)
  unassignedBy           String?           @map("unassigned_by") @db.Uuid
  replacementReason      String?           @map("replacement_reason")
  replacedByAssignmentId String?           @map("replaced_by_assignment_id") @db.Uuid
  season                 AquacultureSeason @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  account                Account           @relation("SeasonAssignedAccount", fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, role], map: "idx_season_assignments_account_active")
  @@map("season_personnel_assignments")
}

/// Read-only KPI projection already created by smartshrimp.sql.
view TechnicianKpi {
  technicianId            String   @unique @map("technician_id") @db.Uuid
  seasonsParticipated     BigInt?  @map("seasons_participated")
  completedTasks          BigInt?  @map("completed_tasks")
  onTimeCompletedTasks    BigInt?  @map("on_time_completed_tasks")
  onTimeCompletionRatePct Decimal? @map("on_time_completion_rate_pct") @db.Decimal

  @@map("v_technician_kpi")
}

/// Read-only Expert KPI projection created by smartshrimp.sql.
view ExpertKpi {
  expertId             String   @unique @map("expert_id") @db.Uuid
  seasonsParticipated  BigInt?  @map("seasons_participated")
  diseaseCasesHandled  BigInt?  @map("disease_cases_handled")
  diseaseCasesResolved BigInt?  @map("disease_cases_resolved")
  avgResolutionHours   Decimal? @map("avg_resolution_hours") @db.Decimal

  @@map("v_expert_kpi")
}

/// Read-only Farm Owner KPI projection created by smartshrimp.sql.
view FarmOwnerKpi {
  farmOwnerId   String  @unique @map("farm_owner_id") @db.Uuid
  farmsOwned    BigInt? @map("farms_owned")
  pondsManaged  BigInt? @map("ponds_managed")
  activeSeasons BigInt? @map("active_seasons")

  @@map("v_farm_owner_kpi")
}

enum RagQueryStatus {
  ANSWERED  @map("answered")
  NO_SOURCE @map("no_source")
  LOW_MATCH @map("low_match")
  ERROR     @map("error")

  @@map("rag_query_status")
}

/// Maps existing SQL tables; season-less legacy conversations are rejected by the service.
model RagConversation {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId     String             @map("account_id") @db.Uuid
  seasonId      String?            @map("season_id") @db.Uuid
  title         String?            @db.VarChar(255)
  startedAt     DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  lastMessageAt DateTime           @default(now()) @map("last_message_at") @db.Timestamptz(6)
  account       Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  season        AquacultureSeason? @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  queries       RagQuery[]

  @@map("rag_conversations")
}

model RagQuery {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId   String          @map("conversation_id") @db.Uuid
  accountId        String          @map("account_id") @db.Uuid
  question         String
  answer           String?
  queryStatus      RagQueryStatus  @map("query_status")
  retrievedChunks  Json            @default("[]") @map("retrieved_chunks") @db.JsonB
  topSimilarity    Decimal?        @map("top_similarity") @db.Decimal(6, 5)
  modelVersion     String?         @map("model_version") @db.VarChar(100)
  processingTimeMs Int?            @map("processing_time_ms")
  errorCode        String?         @map("error_code") @db.VarChar(100)
  errorMessage     String?         @map("error_message")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  conversation     RagConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  account          Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  feedback         RagFeedback?

  @@index([queryStatus, createdAt(sort: Desc)], map: "idx_rag_queries_status_date")
  @@map("rag_queries")
}

model RagFeedback {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queryId     String   @unique @map("query_id") @db.Uuid
  evaluatorId String   @map("evaluator_id") @db.Uuid
  rating      Int      @db.SmallInt
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  query       RagQuery @relation(fields: [queryId], references: [id], onDelete: Restrict)
  evaluator   Account  @relation(fields: [evaluatorId], references: [id], onDelete: Restrict)

  @@index([rating, createdAt(sort: Desc)], map: "idx_rag_feedback_rating_date")
  @@map("rag_feedback")
}
