generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  ADMIN      @map("admin")
  FARM_OWNER @map("farm_owner")
  TECHNICIAN @map("technician")
  EXPERT     @map("expert")

  @@map("account_role")
}

enum AccountStatus {
  PENDING_ACTIVATION @map("pending_activation")
  ACTIVE             @map("active")
  INACTIVE           @map("inactive")
  BLOCKED            @map("blocked")

  @@map("account_status")
}

enum VerificationPurpose {
  ACCOUNT_ACTIVATION @map("account_activation")
  PASSWORD_RESET     @map("password_reset")

  @@map("verification_purpose")
}

enum SeasonStatus {
  PLANNING  @map("planning")
  ACTIVE    @map("active")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")

  @@map("season_status")
}

enum PersonnelRole {
  TECHNICIAN @map("technician")
  EXPERT     @map("expert")

  @@map("personnel_role")
}

enum PondStatus {
  AVAILABLE   @map("available")
  MAINTENANCE @map("maintenance")
  INACTIVE    @map("inactive")

  @@map("pond_status")
}

enum PondType {
  AQUACULTURE     @map("aquaculture")
  WATER_TREATMENT @map("water_treatment")

  @@map("pond_type")
}

enum ShrimpType {
  WHITELEG    @map("whiteleg")
  BLACK_TIGER @map("black_tiger")

  @@map("shrimp_type")
}

enum ProductCategory {
  FEED     @map("feed")
  MEDICINE @map("medicine")
  MINERAL  @map("mineral")
  CHEMICAL @map("chemical")
  OTHER    @map("other")

  @@map("product_category")
}

enum ProductUnit {
  KG     @map("kg")
  G      @map("g")
  L      @map("l")
  ML     @map("ml")
  PACK   @map("pack")
  BOTTLE @map("bottle")
  PCS    @map("pcs")

  @@map("product_unit")
}

enum ConversionUnit {
  MG @map("mg")
  G  @map("g")
  KG @map("kg")
  ML @map("ml")
  L  @map("l")

  @@map("conversion_unit")
}

enum TaskPriority {
  LOW    @map("low")
  NORMAL @map("normal")
  HIGH   @map("high")
  URGENT @map("urgent")

  @@map("task_priority")
}

enum TaskStatus {
  PENDING     @map("pending")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  CANCELLED   @map("cancelled")

  @@map("task_status")
}

enum NotificationType {
  SYSTEM                       @map("system")
  MANAGED_ACCOUNT_ACTIVATED    @map("managed_account_activated")
  ACCOUNT_STATUS_CHANGED       @map("account_status_changed")
  SEASON_ASSIGNMENT_CREATED    @map("season_assignment_created")
  SEASON_ASSIGNMENT_REPLACED   @map("season_assignment_replaced")
  SEASON_STATUS_CHANGED        @map("season_status_changed")
  OPERATION_DUE                @map("operation_due")
  OPERATION_OVERDUE            @map("operation_overdue")
  OPERATION_CANCELLED          @map("operation_cancelled")
  SCHEDULE_GENERATION_FAILED   @map("schedule_generation_failed")
  WATER_THRESHOLD_EXCEEDED     @map("water_threshold_exceeded")
  TASK_ASSIGNED                @map("task_assigned")
  TASK_UPDATED                 @map("task_updated")
  TASK_DUE_SOON                @map("task_due_soon")
  TASK_OVERDUE                 @map("task_overdue")
  TASK_COMPLETED               @map("task_completed")
  DISEASE_CASE_CREATED         @map("disease_case_created")
  DISEASE_CASE_RESPONSE        @map("disease_case_response")
  DISEASE_CASE_WAITING_INFO    @map("disease_case_waiting_info")
  DISEASE_CASE_MONITORING      @map("disease_case_monitoring")
  DISEASE_CASE_RESOLVED        @map("disease_case_resolved")
  PRODUCTION_PROTOCOL_PENDING  @map("production_protocol_pending")
  PRODUCTION_PROTOCOL_REVIEWED @map("production_protocol_reviewed")
  TREATMENT_PROTOCOL_PENDING   @map("treatment_protocol_pending")
  TREATMENT_PROTOCOL_REVIEWED  @map("treatment_protocol_reviewed")
  TREATMENT_PROTOCOL_ABORTED   @map("treatment_protocol_aborted")
  EMERGENCY_CASE_UPDATE        @map("emergency_case_update")
  TREATMENT_SCHEDULE_READY     @map("treatment_schedule_ready")
  TREATMENT_SCHEDULE_COMPLETED @map("treatment_schedule_completed")
  INVENTORY_LOW                @map("inventory_low")
  INVENTORY_INSUFFICIENT       @map("inventory_insufficient")
  HARVEST_DUE                  @map("harvest_due")
  SEASON_COMPLETED             @map("season_completed")

  @@map("notification_type")
}

model Account {
  id                     String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String                       @unique @db.VarChar(320)
  phone                  String?                      @db.VarChar(20)
  passwordHash           String?                      @map("password_hash") @db.VarChar(255)
  fullName               String?                      @map("full_name") @db.VarChar(50)
  avatarUrl              String?                      @map("avatar_url")
  role                   AccountRole
  status                 AccountStatus                @default(PENDING_ACTIVATION)
  managedByOwnerId       String?                      @map("managed_by_owner_id") @db.Uuid
  activatedAt            DateTime?                    @map("activated_at") @db.Timestamptz(6)
  statusChangedBy        String?                      @map("status_changed_by") @db.Uuid
  statusChangedAt        DateTime?                    @map("status_changed_at") @db.Timestamptz(6)
  statusReason           String?                      @map("status_reason")
  lastLoginAt            DateTime?                    @map("last_login_at") @db.Timestamptz(6)
  createdBy              String?                      @map("created_by") @db.Uuid
  createdAt              DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                     @default(now()) @map("updated_at") @db.Timestamptz(6)
  refreshTokens          RefreshToken[]
  verificationChallenges EmailVerificationChallenge[]
  notifications          Notification[]
  managedByOwner         Account?                     @relation("OwnerManagedAccounts", fields: [managedByOwnerId], references: [id], onDelete: Restrict)
  managedAccounts        Account[]                    @relation("OwnerManagedAccounts")
  seasonAssignments      SeasonPersonnelAssignment[]  @relation("SeasonAssignedAccount")
  ownedFarms             Farm[]

  @@map("accounts")
}

model Notification {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId     String           @map("account_id") @db.Uuid
  title         String           @db.VarChar(500)
  content       String?
  type          NotificationType
  referenceType String?          @map("reference_type") @db.VarChar(50)
  referenceId   String?          @map("reference_id") @db.Uuid
  readAt        DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  account       Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model EmailVerificationChallenge {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId            String              @map("account_id") @db.Uuid
  purpose              VerificationPurpose
  codeHash             String              @map("code_hash") @db.Char(64)
  expiresAt            DateTime            @default(dbgenerated("NOW() + INTERVAL '10 minutes'")) @map("expires_at") @db.Timestamptz(6)
  resendAvailableAt    DateTime            @default(dbgenerated("NOW() + INTERVAL '60 seconds'")) @map("resend_available_at") @db.Timestamptz(6)
  failedAttempts       Int                 @default(0) @map("failed_attempts") @db.SmallInt
  verifiedAt           DateTime?           @map("verified_at") @db.Timestamptz(6)
  actionTokenHash      String?             @unique @map("action_token_hash") @db.Char(64)
  actionTokenExpiresAt DateTime?           @map("action_token_expires_at") @db.Timestamptz(6)
  consumedAt           DateTime?           @map("consumed_at") @db.Timestamptz(6)
  supersededAt         DateTime?           @map("superseded_at") @db.Timestamptz(6)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  account              Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, createdAt(sort: Desc)], map: "idx_email_verification_lookup")
  @@map("email_verification_challenges")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(500)
  deviceId  String    @map("device_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Farm {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId           String    @map("owner_id") @db.Uuid
  name              String    @db.VarChar(255)
  address           String?
  latitude          Decimal?  @db.Decimal(10, 8)
  longitude         Decimal?  @db.Decimal(11, 8)
  totalAreaHectares Decimal?  @map("total_area_hectares") @db.Decimal(10, 2)
  isDeleted         Boolean   @default(false) @map("is_deleted")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  owner             Account   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  ponds             Pond[]

  @@map("farms")
}

model Pond {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmId     String              @map("farm_id") @db.Uuid
  name       String              @db.VarChar(255)
  areaM2     Decimal?            @map("area_m2") @db.Decimal(12, 2)
  depthM     Decimal?            @map("depth_m") @db.Decimal(6, 2)
  volumeM3   Decimal?            @map("volume_m3") @db.Decimal(14, 2)
  type       PondType            @default(AQUACULTURE)
  status     PondStatus          @default(AVAILABLE)
  archivedAt DateTime?           @map("archived_at") @db.Timestamptz(6)
  isDeleted  Boolean             @default(false) @map("is_deleted")
  deletedAt  DateTime?           @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  farm       Farm                @relation(fields: [farmId], references: [id], onDelete: Restrict)
  seasons    AquacultureSeason[]

  @@map("ponds")
}

model AquacultureSeason {
  id                   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pondId               String                      @map("pond_id") @db.Uuid
  name                 String                      @db.VarChar(255)
  shrimpType           ShrimpType                  @map("shrimp_type")
  stockingDate         DateTime?                   @map("stocking_date") @db.Date
  expectedEndDate      DateTime?                   @map("expected_end_date") @db.Date
  actualEndDate        DateTime?                   @map("actual_end_date") @db.Date
  initialQuantity      BigInt?                     @map("initial_quantity") @db.BigInt
  initialAvgWeightG    Decimal?                    @map("initial_avg_weight_g") @db.Decimal(10, 3)
  initialBiomassKg     Decimal?                    @map("initial_biomass_kg") @db.Decimal(14, 3)
  initialDensityPerM2  Decimal?                    @map("initial_density_per_m2") @db.Decimal(12, 2)
  status               SeasonStatus                @default(PLANNING)
  cancellationReason   String?                     @map("cancellation_reason")
  createdBy            String                      @map("created_by") @db.Uuid
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  pond                 Pond                        @relation(fields: [pondId], references: [id], onDelete: Restrict)
  personnelAssignments SeasonPersonnelAssignment[]

  @@index([pondId, status], map: "idx_seasons_pond_status")
  @@map("aquaculture_seasons")
}

model Product {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmId             String          @map("farm_id") @db.Uuid
  name               String          @db.VarChar(255)
  category           ProductCategory
  unit               ProductUnit
  conversionQuantity Decimal?        @map("conversion_quantity") @db.Decimal(14, 4)
  conversionUnit     ConversionUnit? @map("conversion_unit")
  minAlertQuantity   Decimal         @default(0) @map("min_alert_quantity") @db.Decimal(14, 3)
  description        String?
  archivedAt         DateTime?       @map("archived_at") @db.Timestamptz(6)
  isDeleted          Boolean         @default(false) @map("is_deleted")
  deletedAt          DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("products")
}

model ProductionProtocolTemplate {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmId             String      @map("farm_id") @db.Uuid
  title              String      @db.VarChar(500)
  description        String?
  shrimpType         ShrimpType? @map("shrimp_type")
  allowedVariancePct Decimal     @default(10) @map("allowed_variance_pct") @db.Decimal(5, 2)
  createdBy          String      @map("created_by") @db.Uuid
  archivedAt         DateTime?   @map("archived_at") @db.Timestamptz(6)
  isDeleted          Boolean     @default(false) @map("is_deleted")
  deletedAt          DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("production_protocol_templates")
}

model Task {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmId             String       @map("farm_id") @db.Uuid
  seasonId           String?      @map("season_id") @db.Uuid
  assignedBy         String       @map("assigned_by") @db.Uuid
  assignedTo         String       @map("assigned_to") @db.Uuid
  title              String       @db.VarChar(500)
  description        String?
  priority           TaskPriority @default(NORMAL)
  status             TaskStatus   @default(PENDING)
  dueAt              DateTime?    @map("due_at") @db.Timestamptz(6)
  startedAt          DateTime?    @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?    @map("completed_at") @db.Timestamptz(6)
  cancellationReason String?      @map("cancellation_reason")
  isDeleted          Boolean      @default(false) @map("is_deleted")
  deletedAt          DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("tasks")
}

model SeasonPersonnelAssignment {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId               String            @map("season_id") @db.Uuid
  role                   PersonnelRole
  accountId              String            @map("account_id") @db.Uuid
  assignedBy             String            @map("assigned_by") @db.Uuid
  assignedAt             DateTime          @default(now()) @map("assigned_at") @db.Timestamptz(6)
  unassignedAt           DateTime?         @map("unassigned_at") @db.Timestamptz(6)
  unassignedBy           String?           @map("unassigned_by") @db.Uuid
  replacementReason      String?           @map("replacement_reason")
  replacedByAssignmentId String?           @map("replaced_by_assignment_id") @db.Uuid
  season                 AquacultureSeason @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  account                Account           @relation("SeasonAssignedAccount", fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, role], map: "idx_season_assignments_account_active")
  @@map("season_personnel_assignments")
}

/// Read-only KPI projection already created by smartshrimp.sql.
view TechnicianKpi {
  technicianId            String   @unique @map("technician_id") @db.Uuid
  seasonsParticipated     BigInt?  @map("seasons_participated")
  completedTasks          BigInt?  @map("completed_tasks")
  onTimeCompletedTasks    BigInt?  @map("on_time_completed_tasks")
  onTimeCompletionRatePct Decimal? @map("on_time_completion_rate_pct") @db.Decimal

  @@map("v_technician_kpi")
}

/// Read-only Expert KPI projection created by smartshrimp.sql.
view ExpertKpi {
  expertId             String   @unique @map("expert_id") @db.Uuid
  seasonsParticipated  BigInt?  @map("seasons_participated")
  diseaseCasesHandled  BigInt?  @map("disease_cases_handled")
  diseaseCasesResolved BigInt?  @map("disease_cases_resolved")
  avgResolutionHours   Decimal? @map("avg_resolution_hours") @db.Decimal

  @@map("v_expert_kpi")
}

/// Read-only Farm Owner KPI projection created by smartshrimp.sql.
view FarmOwnerKpi {
  farmOwnerId   String  @unique @map("farm_owner_id") @db.Uuid
  farmsOwned    BigInt? @map("farms_owned")
  pondsManaged  BigInt? @map("ponds_managed")
  activeSeasons BigInt? @map("active_seasons")

  @@map("v_farm_owner_kpi")
}
