generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  ADMIN      @map("admin")
  FARM_OWNER @map("farm_owner")
  TECHNICIAN @map("technician")
  EXPERT     @map("expert")

  @@map("account_role")
}

enum AccountStatus {
  PENDING_ACTIVATION @map("pending_activation")
  ACTIVE             @map("active")
  INACTIVE           @map("inactive")
  BLOCKED            @map("blocked")

  @@map("account_status")
}

enum VerificationPurpose {
  ACCOUNT_ACTIVATION @map("account_activation")
  PASSWORD_RESET     @map("password_reset")

  @@map("verification_purpose")
}

enum SeasonStatus {
  PLANNING  @map("planning")
  ACTIVE    @map("active")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")

  @@map("season_status")
}

model Account {
  id                     String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String                       @unique @db.Citext
  phone                  String?                      @db.VarChar(20)
  passwordHash           String?                      @map("password_hash") @db.VarChar(255)
  fullName               String?                      @map("full_name") @db.VarChar(50)
  avatarUrl              String?                      @map("avatar_url")
  role                   AccountRole
  status                 AccountStatus                @default(PENDING_ACTIVATION)
  managedByOwnerId       String?                      @map("managed_by_owner_id") @db.Uuid
  activatedAt            DateTime?                    @map("activated_at") @db.Timestamptz(6)
  statusChangedBy        String?                      @map("status_changed_by") @db.Uuid
  statusChangedAt        DateTime?                    @map("status_changed_at") @db.Timestamptz(6)
  statusReason           String?                      @map("status_reason")
  lastLoginAt            DateTime?                    @map("last_login_at") @db.Timestamptz(6)
  createdBy              String?                      @map("created_by") @db.Uuid
  createdAt              DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                     @default(now()) @map("updated_at") @db.Timestamptz(6)
  refreshTokens          RefreshToken[]
  verificationChallenges EmailVerificationChallenge[]
  managedByOwner         Account?                     @relation("OwnerManagedAccounts", fields: [managedByOwnerId], references: [id], onDelete: Restrict)
  managedAccounts        Account[]                    @relation("OwnerManagedAccounts")

  @@map("accounts")
}

model EmailVerificationChallenge {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId            String              @map("account_id") @db.Uuid
  purpose              VerificationPurpose
  codeHash             String              @map("code_hash") @db.Char(64)
  expiresAt            DateTime            @default(dbgenerated("NOW() + INTERVAL '10 minutes'")) @map("expires_at") @db.Timestamptz(6)
  resendAvailableAt    DateTime            @default(dbgenerated("NOW() + INTERVAL '60 seconds'")) @map("resend_available_at") @db.Timestamptz(6)
  failedAttempts       Int                 @default(0) @map("failed_attempts") @db.SmallInt
  verifiedAt           DateTime?           @map("verified_at") @db.Timestamptz(6)
  actionTokenHash      String?             @unique @map("action_token_hash") @db.Char(64)
  actionTokenExpiresAt DateTime?           @map("action_token_expires_at") @db.Timestamptz(6)
  consumedAt           DateTime?           @map("consumed_at") @db.Timestamptz(6)
  supersededAt         DateTime?           @map("superseded_at") @db.Timestamptz(6)
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  account              Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, createdAt(sort: Desc)], map: "idx_email_verification_lookup")
  @@map("email_verification_challenges")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(500)
  deviceId  String    @map("device_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// Minimal mappings for account-status eligibility checks against the existing database.
model Farm {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid

  @@map("farms")
}

model Pond {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  farmId String @map("farm_id") @db.Uuid

  @@map("ponds")
}

model AquacultureSeason {
  id     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pondId String       @map("pond_id") @db.Uuid
  status SeasonStatus

  @@map("aquaculture_seasons")
}

model SeasonPersonnelAssignment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId     String    @map("season_id") @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  unassignedAt DateTime? @map("unassigned_at") @db.Timestamptz(6)

  @@map("season_personnel_assignments")
}

/// Read-only KPI projection already created by smartshrimp.sql.
view TechnicianKpi {
  technicianId            String   @unique @map("technician_id") @db.Uuid
  seasonsParticipated     BigInt?  @map("seasons_participated")
  completedTasks          BigInt?  @map("completed_tasks")
  onTimeCompletedTasks    BigInt?  @map("on_time_completed_tasks")
  onTimeCompletionRatePct Decimal? @map("on_time_completion_rate_pct") @db.Decimal

  @@map("v_technician_kpi")
}

/// Read-only Expert KPI projection created by smartshrimp.sql.
view ExpertKpi {
  expertId             String   @unique @map("expert_id") @db.Uuid
  seasonsParticipated  BigInt?  @map("seasons_participated")
  diseaseCasesHandled  BigInt?  @map("disease_cases_handled")
  diseaseCasesResolved BigInt?  @map("disease_cases_resolved")
  avgResolutionHours   Decimal? @map("avg_resolution_hours") @db.Decimal

  @@map("v_expert_kpi")
}

/// Read-only Farm Owner KPI projection created by smartshrimp.sql.
view FarmOwnerKpi {
  farmOwnerId   String  @unique @map("farm_owner_id") @db.Uuid
  farmsOwned    BigInt? @map("farms_owned")
  pondsManaged  BigInt? @map("ponds_managed")
  activeSeasons BigInt? @map("active_seasons")

  @@map("v_farm_owner_kpi")
}
